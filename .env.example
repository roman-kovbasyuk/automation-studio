NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://<username>:<password>@localhost:5432/<database>
POSTGRES_USER=<username>
POSTGRES_PASSWORD=<password>
POSTGRES_DB=<database>

# Required by the production server
FIREBASE_PROJECT_ID=<firebase-project>
FIREBASE_WEB_API_KEY=<firebase-web-api-key>
FIREBASE_WEB_AUTH_DOMAIN=<firebase-project>.firebaseapp.com
FIREBASE_WEB_APP_ID=<firebase-web-app-id>
VERTEX_AI_PROJECT_ID=<vertex-project>
VERTEX_AI_LOCATION=eu
GENERATION_PROVIDER=gemini
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# 32-byte hex key used to encrypt personal provider credentials (generate with: openssl rand -hex 32).
# This is an app encryption key, not a Gemini API key. Enter provider API keys in Settings.
PERSONAL_CREDENTIAL_ENCRYPTION_KEY=<64-hex-characters>
PERSONAL_CREDENTIAL_ENCRYPTION_KEY_VERSION=v1
ASSET_STORE=gcs
GCS_PROJECT_ID=<gcp-project>
GCS_ASSET_BUCKET=<gcs-bucket>

# Local dev API: keep actual values only in ignored .env (owner permissions 0600).
# These are server-only. Never prefix them with VITE_ or enter them in Settings.
# When enabled, environment credentials take precedence over personal AI settings.
GEMINI_TEXT_API_KEY=
GEMINI_MEDIA_API_KEY=
GEMINI_VIDEO_MODEL=veo-3.1-lite-generate-preview
