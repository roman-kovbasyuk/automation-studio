{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome", "summary", "error"],
  "properties": {
    "outcome": {
      "type": "string",
      "enum": ["implemented", "failed"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "error": {
      "type": ["string", "null"],
      "maxLength": 2000
    }
  }
}
